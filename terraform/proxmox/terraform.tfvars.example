proxmox_api_url          = "https://192.168.10.x:8006/api2/json"
proxmox_api_token_id     = "user@pve!token-name"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

ssh_public_key_path = "~/.ssh/id_rsa.pub"
template_id         = 9000

control_planes = {
  "k3s-cp-01" = { ip = "192.168.10.21", node_name = "pve1", template_id = 9000 }
  "k3s-cp-02" = { ip = "192.168.10.22", node_name = "pve2", template_id = 9001 }
  "k3s-cp-03" = { ip = "192.168.10.23", node_name = "pve2", template_id = 9001 }
}

cp_cores  = 2
cp_memory = 6144
cp_disk   = 32

workers = {
  "k3s-worker-01" = { ip = "192.168.10.52", node_name = "pve1", template_id = 9000 }
  "k3s-worker-02" = { ip = "192.168.10.53", node_name = "pve2", template_id = 9001 }
}

worker_cores  = 2
worker_memory = 6144
worker_disk   = 32

# Permanenta service-VMs (arr-stack, etc.)
service_vms = {}
# service_vms = {
#   "arr-stack" = { ip = "192.168.10.70", node_name = "pve2", cores = 2, memory = 4096, disk = 50 }
# }

# Ad-hoc lab VMs — lägg till vid behov, ta bort när de inte används
test_vms = {}
