services:
  # Whisper large-v3 for study transcription (lectures, YouTube). Separate from the
  # arr-stack 'whisper' (medium, for Bazarr) so the two don't compete. Exposed on the
  # LAN at http://192.168.10.41:9000/asr. CPU-based; slower than medium but fine for
  # background use.
  whisper-large:
    image: onerahmet/openai-whisper-asr-webservice:latest
    container_name: whisper-large
    restart: unless-stopped
    environment:
      - ASR_ENGINE=faster_whisper
      - ASR_MODEL=large-v3
      - TZ=Europe/Stockholm
    volumes:
      - /opt/ai-lab/whisper:/root/.cache
    # Arc iGPU shared via bind mount (group render 993 / video 44) for future
    # OpenVINO acceleration; works in parallel with the media LXC.
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "993"
      - "44"
    ports:
      - 9000:9000
    networks:
      - ai

  # Local LLM (CPU) for the study pipeline: turns Whisper transcripts into summaries +
  # study questions. Runs as overnight batch — quality over speed. Model llama3.3:70b
  # (~45 GB) is pulled by Ansible. KEEP_ALIVE=0 unloads the model after each run so it
  # doesn't hold ~45 GB of RAM idle.
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    environment:
      - OLLAMA_KEEP_ALIVE=0
      - OLLAMA_MAX_LOADED_MODELS=1
      - TZ=Europe/Stockholm
    volumes:
      - /opt/ai-lab/ollama:/root/.ollama
    ports:
      - 11434:11434
    networks:
      - ai

  # Open WebUI (interactive "chat with your lecture" / RAG frontend) — add later if
  # wanted; the study pipeline itself is script-driven and doesn't need it.
  # open-webui:
  #   image: ghcr.io/open-webui/open-webui:main
  #   container_name: open-webui
  #   restart: unless-stopped
  #   environment:
  #     - OLLAMA_BASE_URL=http://ollama:11434
  #   volumes:
  #     - /opt/ai-lab/openwebui:/app/backend/data
  #   ports:
  #     - 3000:8080
  #   networks:
  #     - ai

networks:
  ai:
    driver: bridge
