services:
  # Whisper was moved to pve3 (LXC 202) on 2026-08-02 because CPU transcription
  # competed with the model for pve2's cores, on a host that was thermally unstable at
  # the time. Both objections are gone: PL1=45W gave pve2 a 74 C plateau, and this
  # service is 3.3x faster than pve3 on the same model, so a lecture spends far less
  # time holding any cores at all. The old /opt/ai-lab/whisper cache (~6 GB) is unused.

{% if ai_lab_whisper_ov_enabled %}
  # Whisper through OpenVINO GenAI. Built locally rather than pulled: no published
  # image carries both Intel's NPU user-mode stack and an ASR server.
  #
  # The runtime target is ai_lab_whisper_ov_device — CPU in production, NPU and GPU
  # switchable from the same image. See the defaults for why CPU won: the NPU path
  # only executes the turbo model, which silently drops passages.
  whisper-ov:
    build:
      context: /opt/ai-lab/whisper-ov
    image: whisper-ov:{{ ai_lab_npu_driver_version }}
    container_name: whisper-ov
    restart: unless-stopped
    environment:
      - WHISPER_MODEL={{ ai_lab_whisper_ov_model }}
      - WHISPER_DEVICE={{ ai_lab_whisper_ov_device }}
      - WHISPER_LANGUAGE={{ ai_lab_whisper_ov_language }}
      - TZ=Europe/Stockholm
    volumes:
      # Model cache (HF_HOME), so a restart doesn't re-download ~800 MB.
      - /opt/ai-lab/whisper-ov/models:/models
{% if ai_lab_whisper_ov_device == 'NPU' %}
    devices:
      - /dev/accel/accel0:/dev/accel/accel0
    # render(993) — the same GID the iGPU nodes use, mapped 1:1 into this LXC by the
    # idmap in playbooks/ai-lab.yaml.
    group_add:
      - "993"
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:9000/health"]
      interval: 30s
      timeout: 5s
      # Compiling Whisper takes ~110 s for NPU and ~2.5 s for CPU, and GenAI's
      # CACHE_DIR does not cover Whisper on NPU, so that cost is paid at every start.
      # The CPU value still allows for a first-run model download.
      start_period: {{ 240 if ai_lab_whisper_ov_device == 'NPU' else 120 }}s
      retries: 3
    ports:
      - {{ ai_lab_whisper_ov_port }}:9000
    networks:
      - ai

{% endif %}

  # Local LLM (CPU) for the study pipeline: turns Whisper transcripts into summaries +
  # study questions. Runs as overnight batch — quality over speed. Model llama3.3:70b
  # (~45 GB) is pulled by Ansible. KEEP_ALIVE=0 unloads the model after each run so it
  # doesn't hold ~45 GB of RAM idle.
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    environment:
      - OLLAMA_KEEP_ALIVE=0
      - OLLAMA_MAX_LOADED_MODELS=1
      - TZ=Europe/Stockholm
    volumes:
      - /opt/ai-lab/ollama:/root/.ollama
    ports:
      - 11434:11434
    networks:
      - ai

{% if ai_lab_model_blob %}
  # Same GGUF as Ollama above, but served through llama.cpp's Vulkan backend so the
  # Arrow Lake iGPU (/dev/dri, shared with the media LXC) can take prompt processing.
  # Token generation is bound by DDR5 bandwidth and won't improve — prefill is the
  # thing to measure, and the studieplugg map-reduce chunking is prefill-heavy.
  #
  # NOT started by default: the model is 42 GB and LXC 201 has 52 GB with no swap, so
  # llama.cpp and Ollama must never hold it at the same time. Ollama's KEEP_ALIVE=0
  # unloads after each run; check with `docker exec ollama ollama ps` before starting.
  #   docker compose --profile bench up -d llamacpp
  llamacpp:
    image: {{ ai_lab_llamacpp_image }}
    container_name: llamacpp
    profiles:
      - bench
    restart: unless-stopped
    command: >-
      -m /models/{{ ai_lab_model_blob }}
      --host 0.0.0.0
      --port 8080
      -c {{ ai_lab_llamacpp_ctx }}
      -t {{ ai_lab_llamacpp_threads }}
      -ngl {{ ai_lab_llamacpp_ngl }}
      --parallel 1
      --no-webui
    volumes:
      # Read-only: Ollama owns these blobs, llama.cpp is only a reader.
      - /opt/ai-lab/ollama/models/blobs:/models:ro
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "993"
      - "44"
    ports:
      # Loopback only: llama-server has no auth and allows all CORS origins. The
      # studieplugg pipeline runs on this host anyway, so it never needs the LAN.
      - 127.0.0.1:{{ ai_lab_llamacpp_port }}:8080
    networks:
      - ai

{% endif %}
  # Open WebUI — chat frontend plus RAG ("chat with your lecture"). The studieplugg
  # scripts stay the batch path; this is for asking follow-up questions afterwards.
  #
  # Embeddings run through Ollama rather than Open WebUI's bundled sentence-transformers,
  # so there is one model store to manage and no surprise download on first upload.
  # Open WebUI keeps its own vector index in the data volume — no separate Qdrant/Chroma.
  #
  # Auth is on by default and THE FIRST ACCOUNT REGISTERED BECOMES ADMIN. Create yours
  # immediately after the first start. Bound to the LAN address only, never published
  # through cloudflared; reach it from outside over Tailscale.
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    restart: unless-stopped
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
      - RAG_EMBEDDING_ENGINE=ollama
      - RAG_EMBEDDING_MODEL={{ ai_lab_embedding_model }}
      - TZ=Europe/Stockholm
    volumes:
      - /opt/ai-lab/openwebui:/app/backend/data
    ports:
      - {{ ai_lab_lan_ip }}:{{ ai_lab_openwebui_port }}:8080
    networks:
      - ai

networks:
  ai:
    driver: bridge
