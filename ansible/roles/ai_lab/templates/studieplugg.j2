#!/usr/bin/env bash
# studieplugg — transcribe (Whisper large-v3) then summarize (Ollama) a lecture or
# YouTube video into study material. Runs ON the ai-lab LXC (managed by Ansible).
#
#   studieplugg <youtube-url | /opt/ai-lab/inbox/file> [lang=sv] [model]
#
# Output: /opt/ai-lab/out/<name>/{transkript.txt,sammanfattning.md}
#
# Long lectures are handled with map-reduce: the transcript is split into chunks
# that fit the model context, each chunk is summarized (map), then the partial
# summaries are combined into the final study material (reduce).
set -euo pipefail

# The self-updating yt-dlp binary lives in /usr/local/bin; make sure it wins.
export PATH="/usr/local/bin:${PATH}"

INPUT="${1:?Usage: studieplugg <url|file> [lang] [model]}"
LANG_CODE="${2:-sv}"
MODEL="${3:-{{ ai_lab_llm_model }}}"
WHISPER="{{ ai_lab_whisper_url }}"
OLLAMA="http://localhost:11434"
NTFY_URL="${NTFY_URL:-{{ ai_lab_ntfy_url }}}"
NTFY_RESOLVE="{{ ai_lab_ntfy_resolve }}"

# num_ctx 8192 keeps the 70B KV-cache within the 52 GB LXC (32768 OOM-kills the
# llama-server). CHUNK_WORDS leaves room for the prompt + output inside that window.
NUM_CTX="${NUM_CTX:-{{ ai_lab_num_ctx }}}"
# Generation is latency-bound, not parallel: 14 threads measured 6.3 tok/s against
# 6 threads at 14.2. More threads only help prefill. Ollama auto-detects otherwise.
NUM_THREAD="${NUM_THREAD:-{{ ai_lab_num_thread }}}"
CHUNK_WORDS="${CHUNK_WORDS:-3000}"
KEEP_ALIVE="${KEEP_ALIVE:-15m}"   # keep the model loaded between chunk calls within one run

ts="$(date +%Y%m%d-%H%M%S)"
work="/opt/ai-lab/work/${ts}"; mkdir -p "${work}"

# Call Ollama /api/generate with a prompt, print the response text.
ollama_gen() {
  jq -n --arg m "${MODEL}" --arg p "$1" --arg ka "${KEEP_ALIVE}" --argjson ctx "${NUM_CTX}" --argjson nt "${NUM_THREAD}" \
    '{model:$m, prompt:$p, stream:false, keep_alive:$ka, options:{num_ctx:$ctx, num_thread:$nt}}' \
  | curl -s --max-time 0 "${OLLAMA}/api/generate" -d @- | jq -r '.response'
}

# 1. Resolve input to a media file
if [[ "${INPUT}" =~ ^https?:// ]]; then
  echo "[studieplugg] Downloading ${INPUT}"
  yt-dlp -x --audio-format mp3 -o "${work}/audio.%(ext)s" "${INPUT}"
  media="$(find "${work}" -name 'audio.*' | head -1)"
  name="$(yt-dlp --get-title "${INPUT}" 2>/dev/null | tr -cd '[:alnum:] ._-' | head -c 80 || true)"
else
  media="${INPUT}"
  name="$(basename "${INPUT}")"
fi
name="${name:-${ts}}"
out="/opt/ai-lab/out/${name}"; mkdir -p "${out}"

# 2. Transcribe (Whisper large-v3, on this LXC)
echo "[studieplugg] Transcribing ${media} …"
curl -s --max-time 0 -F "audio_file=@${media}" \
  "${WHISPER}/asr?task=transcribe&output=txt&language=${LANG_CODE}" -o "${out}/transkript.txt"

# 3. Summarize (single-pass if short, else map-reduce)
transcript="${out}/transkript.txt"
words="$(wc -w < "${transcript}")"
final_prompt_tail="Ge tre delar på svenska:
1) En kort helhetssammanfattning (3–5 meningar).
2) Huvudpunkter i punktform.
3) Fem instuderingsfrågor med korta svar."

if (( words <= CHUNK_WORDS )); then
  echo "[studieplugg] Summarizing (${words} ord, single-pass) …"
  ollama_gen "Du är en studiecoach. Sammanfatta följande föreläsningstranskript.
${final_prompt_tail}

Transkript:
$(cat "${transcript}")" > "${out}/sammanfattning.md"
else
  echo "[studieplugg] Long transcript (${words} ord) → map-reduce …"
  mkdir -p "${work}/chunks"
  awk -v max="${CHUNK_WORDS}" -v dir="${work}/chunks" '
    { w += NF; buf = buf $0 "\n";
      if (w >= max) { n++; printf "%s", buf > (dir "/c" sprintf("%03d", n)); buf = ""; w = 0 } }
    END { if (buf != "") { n++; printf "%s", buf > (dir "/c" sprintf("%03d", n)) } }' "${transcript}"

  partials="${work}/partials.md"; : > "${partials}"
  i=0
  for c in "${work}"/chunks/c*; do
    i=$((i + 1))
    echo "[studieplugg]   map: del ${i} …"
    { printf '## Del %s\n' "${i}"
      ollama_gen "Sammanfatta denna DEL av en föreläsning i koncisa punkter på svenska.
Behåll viktiga fakta, namn, siffror och definitioner. Hitta inte på något.

Del:
$(cat "${c}")"
      printf '\n' ; } >> "${partials}"
  done

  echo "[studieplugg]   reduce: slår ihop ${i} delar …"
  ollama_gen "Nedan är delsammanfattningar av en föreläsning, i ordning. Skapa studiematerial utifrån dem.
${final_prompt_tail}

Delsammanfattningar:
$(cat "${partials}")" > "${out}/sammanfattning.md"
fi

# Unload the model so it doesn't hold ~45 GB of RAM after the run.
curl -s "${OLLAMA}/api/generate" -d "{\"model\":\"${MODEL}\",\"keep_alive\":0}" >/dev/null 2>&1 || true

rm -rf "${work}"
echo "[studieplugg] Done → ${out}"

# 4. Notify (best-effort)
if [[ -n "${NTFY_URL}" ]]; then
  curl -s --resolve "${NTFY_RESOLVE}" -H "Title: Studieplugg klar" \
    -d "Klar: ${name} → /opt/ai-lab/out/${name}" "${NTFY_URL}" >/dev/null 2>&1 || true
fi
