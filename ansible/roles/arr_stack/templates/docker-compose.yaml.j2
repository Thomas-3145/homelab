services:
  jellyfin:
    image: jellyfin/jellyfin:latest
    container_name: jellyfin
    restart: unless-stopped
    # GPU render node is group-owned by render (gid 993) / video (gid 44),
    # mapped into the unprivileged LXC via lxc.idmap on pve2. Jellyfin runs as
    # root but must join these groups to access /dev/dri for HW transcoding.
    group_add:
      - "993"
      - "44"
    environment:
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/jellyfin:/config
      # Read-only access to the library; subfolders /data/tv and /data/movies
      - /mnt/media/media:/data:ro
    devices:
      - /dev/dri:/dev/dri
    ports:
      - 8096:8096
    networks:
      - arr

  sonarr:
    image: linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/sonarr:/config
      # Single mount so downloads (/data/torrents) and library (/data/media/tv)
      # share one filesystem -> hardlinks and atomic moves work.
      - /mnt/media:/data
    ports:
      - 8989:8989
    networks:
      - arr

  radarr:
    image: linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/radarr:/config
      - /mnt/media:/data
    ports:
      - 7878:7878
    networks:
      - arr

  prowlarr:
    image: linuxserver/prowlarr:latest
    container_name: prowlarr
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/prowlarr:/config
    ports:
      - 9696:9696
    networks:
      - arr

  qbittorrent:
    image: linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Stockholm
      - WEBUI_PORT=8085
    volumes:
      - /opt/arr-stack/qbittorrent:/config
      # Same /data mount as the *arr apps; set the save path to /data/torrents.
      - /mnt/media:/data
    ports:
      - 8085:8085
      - 6881:6881
      - 6881:6881/udp
    networks:
      - arr

  bazarr:
    image: linuxserver/bazarr:latest
    container_name: bazarr
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/bazarr:/config
      - /mnt/media:/data
    ports:
      - 6767:6767
    networks:
      - arr

  # AI speech-to-text used by Bazarr as a last-resort subtitle provider: when no
  # subtitle is found, Whisper transcribes the audio track into a perfectly synced
  # SRT. CPU-based (faster_whisper) — fast enough on pve2's 14-core Ultra 5.
  whisper:
    image: onerahmet/openai-whisper-asr-webservice:latest
    container_name: whisper
    restart: unless-stopped
    environment:
      - ASR_ENGINE=faster_whisper
      - ASR_MODEL=medium
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/whisper:/root/.cache
    # Exposed on the LAN so other projects (lecture/YouTube transcription) can
    # POST audio to the ASR API at http://192.168.10.40:9000/asr. LAN-only, no auth.
    ports:
      - 9000:9000
    networks:
      - arr

  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    restart: unless-stopped
    environment:
      - LOG_LEVEL=info
      - TZ=Europe/Stockholm
    ports:
      - 8191:8191
    networks:
      - arr

  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    container_name: seerr
    init: true
    restart: unless-stopped
    environment:
      - LOG_LEVEL=info
      - TZ=Europe/Stockholm
    volumes:
      - /opt/arr-stack/seerr:/app/config
    ports:
      - 5055:5055
    networks:
      - arr

  recyclarr:
    image: ghcr.io/recyclarr/recyclarr:latest
    container_name: recyclarr
    user: "1000:1000"
    restart: unless-stopped
    # Syncs TRaSH Guides custom formats + quality profiles into Sonarr/Radarr
    # on a schedule. Config lives in /opt/arr-stack/recyclarr/configs/.
    environment:
      - TZ=Europe/Stockholm
      - CRON_SCHEDULE=@daily
    volumes:
      - /opt/arr-stack/recyclarr:/config
    networks:
      - arr

networks:
  arr:
    driver: bridge
