// Renovate config — automated dependency PRs for this repo.
// Requires the Mend Renovate GitHub App to be installed on the repo:
// https://github.com/apps/renovate
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':timezone(Europe/Stockholm)',
    // Conventional commit messages (chore(deps): ...) — matches pre-commit hook
    ':semanticCommits',
    // Pin GitHub Actions to commit SHAs — a mutable tag like @v7 is a supply
    // chain hole in a workflow that can read the repo. Renovate keeps the
    // human-readable version in a trailing comment.
    'helpers:pinGitHubActionDigests',
  ],
  // Container images in plain manifests (Deployments etc.)
  kubernetes: {
    fileMatch: ['^kubernetes/.+\\.yaml$'],
  },
  // Helm chart versions in ArgoCD Applications (targetRevision)
  argocd: {
    fileMatch: ['^kubernetes/infrastructure/argocd/applications/.+\\.yaml$'],
  },
  // Hook versions in .pre-commit-config.yaml (manager is opt-in)
  'pre-commit': {
    enabled: true,
  },
  // The k3s pin lives in a plain Ansible var, which no built-in manager reads.
  // (system-upgrade-controller needs no entry here — its image tag sits in a
  // Deployment under kubernetes/, so the `kubernetes` manager above finds it.)
  customManagers: [
    {
      // Bumping this alone does NOT upgrade the cluster — it only governs new node
      // installs. The rollout is the matching `version:` change in both Plan CRDs
      // under kubernetes/infrastructure/system-upgrade-controller/.
      customType: 'regex',
      description: 'k3s version pin in Ansible group_vars',
      managerFilePatterns: ['ansible/inventory/group_vars/all.yaml'],
      matchStrings: ['k3s_version:\\s*"(?<currentValue>v[^"]+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'k3s-io/k3s',
    },
    {
      // CI installs these by curl, so no built-in manager sees them. Upstream
      // tags them `kustomize/vX.Y.Z`, hence extractVersion.
      customType: 'regex',
      description: 'kustomize pin in the lint workflow',
      managerFilePatterns: ['^\\.github/workflows/lint\\.yaml$'],
      matchStrings: ['KUSTOMIZE_VERSION:\\s*(?<currentValue>v\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes-sigs/kustomize',
      extractVersionTemplate: '^kustomize/(?<version>.+)$',
    },
    {
      customType: 'regex',
      description: 'kubeconform pin in the lint workflow',
      managerFilePatterns: ['^\\.github/workflows/lint\\.yaml$'],
      matchStrings: ['KUBECONFORM_VERSION:\\s*(?<currentValue>v\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'yannh/kubeconform',
    },
  ],
  packageRules: [
    {
      // Work happens directly on main here, so PRs would otherwise just pile up
      // unreviewed. Automerge keeps dependencies moving; the rules below carve
      // out everything that needs a human. Merges only once CI is green.
      description: 'Automerge patch and minor updates after CI passes',
      matchUpdateTypes: ['patch', 'minor', 'digest', 'pin'],
      automerge: true,
      automergeType: 'branch',
    },
    {
      description: 'Majors can contain migrations (authentik DB, Longhorn engine, kube-prometheus CRDs) — flag clearly, never automerge',
      matchUpdateTypes: ['major'],
      labels: ['major-upgrade'],
      automerge: false,
    },
    {
      description: 'Ghost image tracks major tag only (ghost:5) — let Renovate propose the pinned minor when ready',
      matchPackageNames: ['ghost'],
      enabled: false,
    },
    {
      description: 'SUC manifests are vendored — a PR only bumps the image tag, crd.yaml must be re-vendored by hand (see its kustomization.yaml)',
      matchPackageNames: ['rancher/system-upgrade-controller'],
      labels: ['needs-revendor'],
      automerge: false,
    },
  ],
  // Keep PR noise low on a single-maintainer repo
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
}
